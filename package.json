{
  "name": "ep-crm-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node server/sync-routes.mjs && prettier --check . && ng build @ep-crm/core && eslint . && ng test @ep-crm/core --watch=false && ng test @ep-crm/devkit --watch=false && ng test ep-crm-demo --watch=false",
    "test:core": "ng test @ep-crm/core",
    "test:devkit": "ng build @ep-crm/core && ng test @ep-crm/devkit",
    "test:app": "ng test ep-crm-demo",
    "prod": "ng build --configuration production",
    "prod:iis": "ng build --configuration production,iis",
    "build:bpmsoft": "ng build --configuration development,bpmsoft",
    "build:terrasoft": "ng build --configuration development,terrasoft",
    "build:core": "ng build @ep-crm/core",
    "build:devkit": "ng build @ep-crm/devkit",
    "build:libs": "ng build @ep-crm/core && ng build @ep-crm/devkit",
    "build:probe": "ng build ep-crm-probe && esbuild dist/probe/main.js --bundle --format=iife --minify --outfile=dist/probe/ep-crm-probe.js",
    "routes:sync": "node server/sync-routes.mjs --write",
    "routes:check": "node server/sync-routes.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.2.0",
    "esbuild": "0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.4.1",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.0.8"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  }
}
