<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.web>
    <httpCookies domain="" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <httpErrors existingResponse="PassThrough" />
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
    <rewrite>
      <rules>
        <rule name="Session expired" stopProcessing="true">
          <match url="^session-expired$" />
          <action type="CustomResponse" statusCode="401" statusReason="Unauthorized"
                  statusDescription="Session expired" />
        </rule>
        <rule name="Angular Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(crm)" negate="true" />
          </conditions>
          <action type="Rewrite" url="./index.html" />
        </rule>
        <rule name="Crm Workspace Routes" stopProcessing="true">
          <match url="^crm/([_0-9a-zA-Z-]+)(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{WorkspaceRoutes:{R:1}}" pattern="(.+)" />
          </conditions>
          <action type="Rewrite" url="{Backend:url}{Workspace:prefix}{C:1}{R:2}" />
        </rule>
        <rule name="Crm Application Routes" stopProcessing="true">
          <match url="^crm/([_0-9a-zA-Z-]+)(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{ApplicationRoutes:{R:1}}" pattern="(.+)" />
          </conditions>
          <action type="Rewrite" url="{Backend:url}{C:1}{R:2}" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Cookie path rewrite">
          <match serverVariable="RESPONSE_Set_Cookie" pattern="^(.*; path=)/\d+/?(.*)" />
          <action type="Rewrite" value="{R:1}/{R:2}" />
        </rule>
        <rule name="No cache for html" preCondition="IsHtml">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-cache, no-store, must-revalidate" />
        </rule>
        <rule name="Login redirect to session marker">
          <match serverVariable="RESPONSE_LOCATION" pattern="/Login/Login\.html" />
          <action type="Rewrite" value="/session-expired" />
        </rule>
        <preConditions>
          <preCondition name="IsHtml">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
          </preCondition>
        </preConditions>
      </outboundRules>
      <rewriteMaps>
        <rewriteMap name="Backend" defaultValue="http://localhost:80">
          <!-- 
            To activate this key, uncomment the line below 
            and replace [CRM_BACKEND] with your actual backend URL.
          -->
          <!--<add key="url" value="[CRM_BACKEND]" />-->
        </rewriteMap>
          <!--
             The workspace prefix is a property of the stand, not of the list of services: an
             application on .NET Core answers without one, an application on .NET Framework answers
             under a numbered workspace. Uncomment the key and put in what the platform reports in
             workspaceBaseUrl ("/0" for http://localhost:80/0); an empty map means no prefix.
          -->
        <rewriteMap name="Workspace" defaultValue="">
          <!--<add key="prefix" value="/0" />-->
        </rewriteMap>
        <rewriteMap name="WorkspaceRoutes" defaultValue="">
          <!-- >>> workspace services, generated from src/app/config/service-routes.json by "pnpm routes:sync" — do not edit by hand -->
          <add key="logout" value="/rest/MainMenuService/Logout" />
          <add key="currentUserInfo" value="/ServiceModel/UserInfoService.svc/GetCurrentUserInfo" />
          <add key="select" value="/DataService/json/SyncReply/SelectQuery" />
          <add key="insert" value="/DataService/json/SyncReply/InsertQuery" />
          <add key="update" value="/DataService/json/SyncReply/UpdateQuery" />
          <add key="delete" value="/DataService/json/SyncReply/DeleteQuery" />
          <add key="batch" value="/DataService/json/SyncReply/BatchQuery" />
          <add key="entitySchemaManager" value="/DataService/json/SyncReply/EntitySchemaManagerRequest" />
          <add key="entitySchema" value="/DataService/json/SyncReply/EntitySchemaRequest" />
          <add key="entityImg" value="/img/entity/hash/SysImage/Data" />
          <add key="rights" value="/rest/RightsService/GetSchemaOperationRightLevel" />
          <add key="runProcess" value="/ServiceModel/ProcessEngineService.svc/RunProcess" />
          <add key="deleteRecords" value="/rest/GridUtilitiesService/DeleteRecordsAsync" />
          <!-- <<< end of the generated block -->
        </rewriteMap>
        <rewriteMap name="ApplicationRoutes" defaultValue="">
          <!-- >>> application services, generated from src/app/config/service-routes.json by "pnpm routes:sync" — do not edit by hand -->
          <add key="ping" value="/api/HealthCheck/Ping" />
          <add key="login" value="/ServiceModel/AuthService.svc/Login" />
          <!-- <<< end of the generated block -->
        </rewriteMap>
      </rewriteMaps>
    </rewrite>
  </system.webServer>
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="01:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="locale">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="01:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="favicon.ico">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
