{
  "name": "branch-naming-convention",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "refs/heads/main",
        "refs/heads/feat/**",
        "refs/heads/fix/**",
        "refs/heads/hotfix/**",
        "refs/heads/chore/**",
        "refs/heads/dependabot/**"
      ]
    }
  },
  "rules": [
    {
      "type": "creation"
    }
  ]
}
